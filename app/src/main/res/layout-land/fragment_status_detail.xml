<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkBluePers">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/redPers">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/status_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status title"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/status_detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="incident • high"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:alpha="0.9"
                android:gravity="center"
                android:paddingTop="10dp"/>

            <TextView
                android:id="@+id/status_detail_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="created_at"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:alpha="0.85"
                android:gravity="center"
                android:paddingTop="6dp"/>

            <TextView
                android:id="@+id/status_detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="content..."
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:paddingTop="16dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- splash / loading (igual que en tu detail actual) -->
    <include
        android:id="@+id/detail_loading_splash"
        layout="@layout/activity_splashscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
