<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="@string/settingsTitle"
        android:textAlignment="center"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/NightMode"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/cb_night_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ActiveDesactText"
        android:textColor="?attr/colorOnPrimary"
        android:layout_marginBottom="18dp"
        android:textSize="16sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="@string/LenguageText"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/lang_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/lang_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/EnTextLenguage"
            android:textColor="?attr/colorOnPrimary" />

        <RadioButton
            android:id="@+id/lang_es"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/EsTextLenguage"
            android:textColor="?attr/colorOnPrimary" />

        <RadioButton
            android:id="@+id/lang_cat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/CatTextLenguage"
            android:textColor="?attr/colorOnPrimary" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_apply_lang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/SettingsApplyButton"
        android:backgroundTint="?attr/colorSecondary"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_version"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
